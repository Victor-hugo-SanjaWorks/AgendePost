# Optional environment variables. Copy only after review and load explicitly with your shell
# or: node --env-file=.env server.mjs. The npm start command does not implicitly load .env.
# Local profile only. For Hostinger VPS use deploy/agendepost.env.example and docs/HOSTINGER-DEPLOY.md.
# The application always binds loopback; hosted profile requires a trusted same-host HTTPS proxy.
NODE_ENV=development
SOCIAL_SAAS_DEPLOYMENT=local
SOCIAL_SAAS_HOST=127.0.0.1
SOCIAL_SAAS_PORT=4180
SOCIAL_SAAS_ORIGIN=http://127.0.0.1:4180
# SOCIAL_SAAS_DATA_DIR=/absolute/path/to/a/dedicated/private/social-saas-data
# Default setup uses no provider credentials. Optional Meta activation requires separately authorized private server configuration; never put real secrets in this example.

# Publicação real: desativada por padrão; consulte docs/META-INTEGRATION.md.
# Nunca coloque tokens neste arquivo nem envie segredos em conversas.
SOCIAL_SAAS_META_ENABLED=false
SOCIAL_SAAS_PUBLISHING_WORKER=false
# SOCIAL_SAAS_META_CONFIG_FILE=/caminho/privado/configuracao-meta.json

# Optional read-only social collection and optional official WhatsApp notifications.
# Both are disabled until separately configured and explicitly enabled by the operator.
SOCIAL_SAAS_METRICS_ENABLED=false
SOCIAL_SAAS_WHATSAPP_ENABLED=false
# SOCIAL_SAAS_WHATSAPP_CONFIG_FILE=/etc/agendepost/whatsapp/cloud-api.json
