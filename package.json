{
  "name": "agendepost-hosted-pilot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:http": "node --test tests/qa-http.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "dev:mail": "node scripts/dev-mail.mjs",
    "admin:grant": "node scripts/admin-grant.mjs",
    "backup": "node scripts/backup.mjs",
    "operator:access": "node scripts/operator-access.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "test:hosted": "node --test --test-concurrency=1 tests/hosted*.test.mjs",
    "test:runtime": "node scripts/smoke-hosted-runtime.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:client": "node --test --test-concurrency=1 tests/dashboard*.test.mjs tests/client-approvals*.test.mjs tests/social-metrics*.test.mjs tests/whatsapp*.test.mjs tests/upgrade*.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "sharp": "0.35.5",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "jsdom": "30.1.2"
  }
}
