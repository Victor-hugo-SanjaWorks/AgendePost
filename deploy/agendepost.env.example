# Install reviewed values as /etc/agendepost/agendepost.env, never in the web root.
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell substitutions.
NODE_ENV=production
SOCIAL_SAAS_DEPLOYMENT=hosted-pilot
SOCIAL_SAAS_HOST=127.0.0.1
SOCIAL_SAAS_PORT=4180
SOCIAL_SAAS_ORIGIN=https://agendepost.com.br
SOCIAL_SAAS_TRUST_PROXY=loopback
SOCIAL_SAAS_DATA_DIR=/var/lib/agendepost
SOCIAL_SAAS_META_ENABLED=false
SOCIAL_SAAS_META_OAUTH_ENABLED=false
SOCIAL_SAAS_PUBLISHING_WORKER=false
# Meta OAuth requires separate authorization and protected configuration files.
# SOCIAL_SAAS_META_OAUTH_CONFIG_FILE=/etc/agendepost/meta/meta-oauth.json
# SOCIAL_SAAS_META_ENCRYPTION_KEY_FILE=/etc/agendepost/meta/meta-token-key
# Do not enable publishing or add credentials during the hosting-only pilot setup.

# Optional read-only social collection and optional official WhatsApp notifications.
# Both are disabled until separately configured and explicitly enabled by the operator.
SOCIAL_SAAS_METRICS_ENABLED=false
SOCIAL_SAAS_WHATSAPP_ENABLED=false
# SOCIAL_SAAS_WHATSAPP_CONFIG_FILE=/etc/agendepost/whatsapp/cloud-api.json
